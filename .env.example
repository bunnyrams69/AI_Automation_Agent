# ==============================================================================
# WhatsApp AI Lead Qualification & Site-Visit Booking Agent Environment Config
# Copy this file to .env and replace the placeholder values.
# NEVER commit the .env file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Public URL where this server is accessible from Meta & Cal.com (e.g., via Cloudflare tunnel or ngrok)
PUBLIC_BASE_URL=https://your-domain-or-tunnel.trycloudflare.com

# Supabase Database & Storage Configuration
# Project URL from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role Key from Supabase Project Settings -> API (Secret, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJh...
# Anon Public Key from Supabase Project Settings -> API
SUPABASE_ANON_KEY=eyJh...

# Meta WhatsApp Cloud API Configuration
# Phone Number ID from Meta Developer App -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WhatsApp Business Account ID from Meta Developer App -> WhatsApp -> API Setup
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
# Meta Graph API Access Token (System User permanent token recommended for production)
WHATSAPP_ACCESS_TOKEN=EAAG...
# Meta App Secret from Meta Developer App -> App Settings -> Basic
WHATSAPP_APP_SECRET=abcdef1234567890abcdef1234567890
# Secret verification token you invent and paste into Meta Webhook Configuration modal
WHATSAPP_VERIFY_TOKEN=my_secure_random_verify_token_12345
# Meta Graph API Version (configured per Meta's latest release: v26.0)
WHATSAPP_API_VERSION=v26.0

# Google Gemini AI Configuration
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...
# Gemini Model name supporting tool calling and audio input (Free Tier default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Admin REST API Security
# Static API Key header (x-admin-key) or Bearer token for accessing /admin routes
ADMIN_API_KEY=admin_secret_key_change_in_production_98765

# Business Localization & Owner Notification
# Business Timezone for booking availability and reminders (e.g. Asia/Kolkata)
BUSINESS_TIMEZONE=Asia/Kolkata
# Owner notification email receiving HOT lead alerts, site visit summaries, and handoffs
NOTIFY_EMAIL=owner@example.com

# ==============================================================================
# Cal.com v2 Scheduling Integration
# ==============================================================================
# Cal.com API v2 Key: Generated from Cal.com Dashboard -> Settings -> Developer -> API Keys
CAL_API_KEY=cal_live_...
# Bookings API version header (2024-08-13 is standard for Cal v2 bookings)
CAL_API_VERSION=2024-08-13
# Slots API version header (2024-09-04 is required for GET /slots in Cal v2)
CAL_SLOTS_API_VERSION=2024-09-04
# Default Event Type ID: Integer found in event type URL or via GET https://api.cal.com/v2/event-types
CAL_DEFAULT_EVENT_TYPE_ID=1234567
# Webhook signing secret you invent and paste into Cal.com Webhook setup (Settings -> Webhooks)
CAL_WEBHOOK_SECRET=cal_webhook_secret_secure_98765
# Fallback email used for Cal.com booking if lead skips or doesn't provide email
CAL_FALLBACK_ATTENDEE_EMAIL=bookings@example.com

# ==============================================================================
# Email Notification Outbox (SMTP / Resend)
# ==============================================================================
# Provider options: smtp | resend | mock (default: mock for local testing)
EMAIL_PROVIDER=mock
# SMTP Host (e.g., smtp.gmail.com)
SMTP_HOST=smtp.gmail.com
# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587
# Secure connection boolean (false for port 587, true for port 465)
SMTP_SECURE=false
# SMTP User: Your email address
SMTP_USER=your_email@example.com
# SMTP Password: App Password if using Gmail (Google Account -> Security -> 2-Step -> App Passwords)
SMTP_PASS=xxxx xxxx xxxx xxxx
# Outbound From email header
EMAIL_FROM=Apex Real Estate <notifications@example.com>
# Optional Resend API Key if EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Voice & Audio Settings
# Enable voice replies to voice notes (true/false, default: false)
VOICE_REPLY_ENABLED=false
# TTS provider if VOICE_REPLY_ENABLED is true: gemini | elevenlabs | mock
TTS_PROVIDER=mock
# Optional ElevenLabs API Key if TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Optional ElevenLabs Voice ID if TTS_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=
